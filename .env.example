# ============================================================
#  MODELO do .env — este SIM pode ir pro git (não tem senhas reais).
#  Copie para ".env" e preencha com os valores da sua máquina:
#     cp .env.example .env
# ============================================================

DATABASE_URL=postgresql+psycopg2://postgres:SUA_SENHA_AQUI@localhost:5432/estagios_fono

# Assina o cookie de sessão. TROCAR em produção: mudar esta chave derruba todas as
# sessões abertas (é o jeito de expulsar todo mundo, se precisar).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-isto-por-uma-chave-aleatoria-longa

# Validade da sessão em horas (12 = um dia de trabalho).
SESSAO_HORAS=12

# dev | prod  — em `prod` o cookie de sessão vai como `secure` (exige HTTPS) e o CORS fecha.
APP_ENV=dev
